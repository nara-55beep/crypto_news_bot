# Copy the names you use into system environment variables or a private deployment
# secret store. This project reads these with os.getenv; it does not automatically
# load this file. Never put real values in this committed example.

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_SESSION=tg_session

# AI/news providers
GROQ_API_KEY=
ANTHROPIC_API_KEY=
TOA_API_KEY=

# Optional market-data providers
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Solana memecoin intelligence (the page always remains PAPER-only)
# DEX Screener discovery and keyless Jupiter quotes work without credentials.
# Birdeye Premium enables the exhaustive new-listing/new-pair/meme WebSocket.
MEMECOIN_MODE=PAPER
MEMECOIN_DISCOVERY_INTERVAL_SEC=20
MEMECOIN_CANDIDATE_LIMIT=30
MEMECOIN_MIN_LIQUIDITY_USD=25000
MEMECOIN_MAX_PAPER_POSITION_SOL=0.25
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BIRDEYE_API_KEY=
HELIUS_API_KEY=
JUPITER_API_KEY=
X_API_BEARER_TOKEN=
DISCORD_BOT_TOKEN=
TWITCH_CLIENT_ID=

# GMGN feed and guarded live-copy settings for trenchflippermoney.
# The public GMGN page may return 403; the default path uses gmgn-cli instead.
GMGN_TRADE_FEED_URL=https://gmgn.ai/robinhood/address/0x3ad83204e37fb98cd83ac523dfb65f7f99bb716d

# Keep false until docs/trenchflippermoney-live.md is complete. The address is
# public and can instead be selected with "Connect Phantom" on /paper.
GMGN_COPY_LIVE_ENABLED=false
GMGN_COPY_WALLET_ADDRESS=
GMGN_COPY_LIVE_BUDGET_USD=10
GMGN_COPY_MAX_SLIPPAGE_PERCENT=10

# Required by gmgn-cli in addition to its --yes flag for headless real trades.
GMGN_ALLOW_AUTOMATED_TRADES=0

# Configure these with `gmgn-cli config` in ~/.config/gmgn/.env instead of here.
# GMGN_PRIVATE_KEY is an Ed25519 API-signing PEM, NOT a Phantom recovery phrase
# or blockchain private key. Never paste any Phantom secret into this project.
# GMGN_API_KEY=
# GMGN_PRIVATE_KEY=

# Optional Lucid feed authentication
LUCID_TRADINGVIEW_AUTH_TOKEN=
LUCID_BRIDGE_TOKEN=

# Lighter account and signing credentials
LIGHTER_L1_ADDRESS=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_KEY_INDEX=
